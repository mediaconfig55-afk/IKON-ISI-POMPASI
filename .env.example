# TypeSafe (Jev) — Akıllı Ürün Danışmanı için.
# Boş bırakılırsa danışman kural tabanlı yedek mantıkla çalışır, site kırılmaz.
# Anahtarı https://typesafe.ai üzerinden alıp buraya yazın, Vercel'de ise
# Project Settings > Environment Variables bölümüne ekleyin.
TYPESAFE_API_KEY=

